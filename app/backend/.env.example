MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Ledger
DB_NAME=finance_tracker_saas
CORS_ORIGINS=http://localhost:3000

# "production" enables stricter behavior in a few places; anything else is treated as local/dev
ENVIRONMENT=development

# Firebase Admin SDK JSON string
FIREBASE_CREDENTIALS={"type": "service_account", "project_id": "...", "private_key": "..."}

# Razorpay Keys — use rzp_test_ keys until your live account is activated
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_PLAN_MONTHLY=plan_...
RAZORPAY_PLAN_YEARLY=plan_...
# Required to verify /api/payments/webhook signatures — without this the webhook
# accepts unsigned requests. Set from Razorpay Dashboard > Webhooks.
RAZORPAY_WEBHOOK_SECRET=...

# Google Gemini — powers KOIN AI chat (primary model)
GEMINI_API_KEY=...

# Groq — fallback model if Gemini fails/rate-limits
GROQ_API_KEY=...
GROQ_MODEL=llama-3.3-70b-versatile

# Gmail SMTP (enable 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dhruvghanchi.1@gmail.com
SMTP_PASSWORD=your_16_char_app_password
CONTACT_EMAIL_TO=dhruvghanchi.1@gmail.com